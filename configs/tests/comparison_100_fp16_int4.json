{
  "base_model": "TON_MODELE_HF_OU_CHEMIN_LOCAL",
  "input": "data/prompts.jsonl",
  "output_dir": "outputs/test_100_fp16_int4",
  "limit": 100,
  "max_new_tokens": 256,
